# emrearas.com — Production build-time environment

# ========================================
# AI Worker (ai-worker.emrearas.com)
# ========================================
# The chat component picks its endpoint by build mode. Only the production one
# belongs here: the dev branch is compiled out of a production build, so the
# deploy workflow does not set it either.
VITE_AI_WORKER_PRODUCTION_ENDPOINT=

# Turnstile site key for www.emrearas.com (Cloudflare dashboard → Turnstile).
VITE_AI_WORKER_TURNSTILE_SITE_KEY=
