# emrearas.com — Development build-time environment

# ========================================
# AI Worker (ai-worker.emrearas.com)
# ========================================
# The chat component picks its endpoint by build mode, so only the dev one
# belongs here: `npm run dev` reads this, a production build reads
# .env.production instead. Point it at the local worker, e.g.
# http://localhost:8791 when `npm run dev` is running in workers/ai-worker.
VITE_AI_WORKER_DEV_ENDPOINT=

# Turnstile site key. Cloudflare publishes always-passing test keys for local
# work (the visible-widget one is 1x00000000000000000000AA); the real key
# belongs in .env.production.
VITE_AI_WORKER_TURNSTILE_SITE_KEY=
