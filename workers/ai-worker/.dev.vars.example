# emrearas.com AI Worker - Development Environment Variables
# Copy to .dev.vars and fill in. TURNSTILE dummy secret always passes;
# use 3x0000000000000000000000000000000AA to test the already-spent path.

ANTHROPIC_API_KEY=
# Optional: point the SDK at an AI Gateway endpoint (or a local mock).
# ANTHROPIC_BASE_URL=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SESSION_SIGNING_KEY=dev-only-signing-key-change-me
ENVIRONMENT=development
