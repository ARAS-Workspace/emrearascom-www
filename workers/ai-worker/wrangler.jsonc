/**
 * emrearas.com AI Worker Configuration
 * For more details: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emrearas-ai-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	/** Required by @anthropic-ai/sdk (imports Node built-ins). */
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	/**
	 * The custom domain (ai-worker.emrearas.com) is attached in the Cloudflare
	 * dashboard, not here — same as the other workers in this account. A
	 * `routes` entry would try to own the domain on every deploy and fight the
	 * dashboard binding. The site reaches the worker through
	 * VITE_AI_WORKER_PRODUCTION_ENDPOINT, so this config never needs its own
	 * hostname.
	 */
	/**
	 * Text module — the system prompt ships as a bundled .md import.
	 */
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.md"
			],
			"fallthrough": true
		}
	],
	/**
	 * D1 Database — the conversation record and integrity chain
	 * (conversation_logs) plus the daily token meter (daily_usage). Both are
	 * required at runtime and both are created by the single schema migration.
	 * The commands below are for recreating the database elsewhere or working
	 * locally.
	 *
	 * Create database:
	 *   npx wrangler d1 create emrearas-ai-logs
	 *
	 * Apply the schema (local):
	 *   npx wrangler d1 migrations apply emrearas-ai-logs --local
	 *
	 * Apply the schema (remote/production):
	 *   npx wrangler d1 migrations apply emrearas-ai-logs --remote
	 *
	 * Query (local):
	 *   npx wrangler d1 execute emrearas-ai-logs --local --command="SELECT * FROM conversation_logs"
	 *
	 * Reset local database (migrations have to be re-applied afterwards):
	 *   rm -rf .wrangler/state
	 */
	"d1_databases": [
		{
			"binding": "AI_LOGS_DB",
			"database_name": "emrearas-ai-logs",
			"database_id": "bf7039c2-e56f-44ce-92a1-3477d39cb836"
		}
	]
	/**
	 * Production Secrets (set via CLI):
	 * npx wrangler secret put ANTHROPIC_API_KEY
	 * npx wrangler secret put TURNSTILE_SECRET_KEY
	 *
	 * SESSION_SIGNING_KEY signs the session tokens and is never shown to a
	 * client, so it only has to be long and random — generate and set it in
	 * one go (rotating it just invalidates live sessions; clients re-solve
	 * the Turnstile challenge and carry on):
	 *   openssl rand -base64 48 | npx wrangler secret put SESSION_SIGNING_KEY
	 */
	/**
	 * Development: use a .dev.vars file (see .dev.vars.example).
	 */
}
