# Cloudflare D1 read access.
#
# Copy to .env and fill in. The dashboard runs on your machine and talks
# straight to the D1 HTTP API; nothing here is deployed anywhere.

# Account API token. It needs D1:Read on this account and nothing else —
# create it under My Profile > API Tokens with the "D1" template, then narrow
# the permission to Read. A token with write access is a token that can break
# the integrity chain this dashboard exists to verify.
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID, from the dashboard URL or `wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# The worker's database id — the same value as `database_id` in
# workers/ai-worker/wrangler.jsonc.
D1_DATABASE_ID=
